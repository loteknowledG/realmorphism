{
  "name": "realmorphism",
  "version": "0.0.0",
  "description": "A starter for creating a TypeScript package.",
  "homepage": "https://loteknowledg.github.io/realmorphism/",
  "bugs": {
    "url": "https://github.com/author/library/issues"
  },
  "license": "MIT",
  "author": "Author Name <author.name@mail.com>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/loteknowledG/realmorphism.git"
  },
  "files": [
    "dist",
    "src"
  ],
  "type": "module",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./styles/kit.css": "./src/styles/realmorphism-kit.css",
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "vp pack",
    "demo": "node ./node_modules/vite/dist/vite/node/cli.js",
    "build:demo": "vp build",
    "dev": "vp pack --watch",
    "test": "vp test",
    "check": "vp check",
    "registry:build": "node ./scripts/build-registry.mjs",
    "prepublishOnly": "vp run build"
  },
  "devDependencies": {
    "@radix-ui/react-slot": "^1.2.4",
    "@tailwindcss/vite": "^4.2.2",
    "@types/node": "^25.5.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@typescript/native-preview": "7.0.0-dev.20260328.1",
    "@vitejs/plugin-react": "^6.0.1",
    "bumpp": "^11.0.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.8.0",
    "shadcn": "^4.2.0",
    "tailwind-merge": "^3.5.0",
    "tailwindcss": "^4.2.2",
    "tw-animate-css": "^1.4.0",
    "typescript": "^6.0.2",
    "vite": "8.0.8",
    "vite-plus": "^0.1.18"
  },
  "peerDependencies": {
    "react": "^19.2.5",
    "react-dom": "^19.2.5"
  },
  "packageManager": "pnpm@10.33.0",
  "inlinedDependencies": {
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "lucide-react": "1.8.0",
    "tailwind-merge": "3.5.0"
  },
  "dependencies": {
    "@radix-ui/react-checkbox": "^1.3.3",
    "@radix-ui/react-label": "^2.1.8",
    "@radix-ui/react-switch": "^1.2.6",
    "embla-carousel": "^8.6.0",
    "embla-carousel-react": "^8.6.0",
    "react": "^19.2.5",
    "react-dom": "^19.2.5"
  }
}
